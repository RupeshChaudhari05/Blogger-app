<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <View android:id="@+id/separator"
            android:background="@android:color/darker_gray"
            android:layout_width="fill_parent"
            android:layout_height="0.5dip"
            android:layout_below="@+id/layout_quotes_parent_view2" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:id="@+id/tt"
            android:layout_marginRight="10.0dip"
            android:baselineAligned="false"
            android:layout_below="@id/separator">

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_quote_save"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">

                <ImageView android:id="@+id/iv_save_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/ic_menu_save"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_save_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:textColor="@android:color/black"
                    android:text="Save" />

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/imageUpload"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/icons8_plus_30"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:textColor="@android:color/black"
                    android:text="Upload" />

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_quote_share"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/share_24"
                    app:tint="@color/black"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:textColor="@android:color/black"
                    android:text="Share" />

            </LinearLayout>

        </LinearLayout>


        <View android:id="@+id/separator1"
            android:background="@android:color/darker_gray"
            android:layout_width="fill_parent"
            android:layout_height="0.5dip"
            android:layout_below="@+id/tt" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginRight="10.0dip"
            android:baselineAligned="false"
            android:layout_below="@id/separator1">

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/fontpopup"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">

                <ImageView android:id="@+id/font1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/icons8_font_24"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:gravity="center"
                    android:id="@+id/font2"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:textColor="@android:color/black"
                    android:text="Font" />

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/colorPiker"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/ic_data_usage"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:textColor="@android:color/black"
                    android:text="Color" />

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/blurIffect"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">

                <ImageView android:id="@+id/ic_plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/blur"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:gravity="center"
                    android:id="@+id/fff"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:textColor="@android:color/black"
                    android:text="Blur" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>